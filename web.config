<?xml version="1.0" encoding="UTF-8"?>
<!--
  ============================================================================
   IIS 設定（僅在「網站根目錄指到專案根目錄」時才需要）
  ============================================================================

   如果網站根目錄已經指到 public\，這個檔案不會生效，也不需要它。

   工廠環境常見的是 IIS + PHP，所以 Apache 與 IIS 兩份設定都先備好。
-->
<configuration>
    <system.webServer>

        <!-- 擋掉非公開目錄 -->
        <security>
            <requestFiltering>
                <hiddenSegments>
                    <add segment="app" />
                    <add segment="config" />
                    <add segment="storage" />
                    <add segment="vendor" />
                    <add segment="tools" />
                </hiddenSegments>
                <fileExtensions>
                    <add fileExtension=".log" allowed="false" />
                    <add fileExtension=".lock" allowed="false" />
                </fileExtensions>
            </requestFiltering>
        </security>

        <rewrite>
            <rules>
                <!-- 根目錄的請求轉進 public\ -->
                <rule name="ForwardToPublic" stopProcessing="true">
                    <match url="^(?!public/)(.*)$" />
                    <conditions logicalGrouping="MatchAny">
                        <add input="{DOCUMENT_ROOT}/public/{R:1}" matchType="IsFile" />
                        <add input="{DOCUMENT_ROOT}/public/{R:1}" matchType="IsDirectory" />
                    </conditions>
                    <action type="Rewrite" url="public/{R:1}" />
                </rule>
            </rules>
        </rewrite>

        <httpProtocol>
            <customHeaders>
                <remove name="X-Powered-By" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
            </customHeaders>
        </httpProtocol>

        <defaultDocument>
            <files>
                <clear />
                <add value="index.php" />
            </files>
        </defaultDocument>

    </system.webServer>
</configuration>
